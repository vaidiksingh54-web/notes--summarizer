rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Health / connection check probe
    match /test/{docId} {
      allow get: if true;
    }

    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Schema validation helpers
    function isValidUser(data, userId) {
      return data.keys().hasAll(['id', 'email', 'name'])
        && data.id is string && data.id == userId
        && data.email is string && data.email.size() <= 256
        && data.name is string && data.name.size() <= 128;
    }

    function isValidStudyItem(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'type'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == userId
        && data.title is string && data.title.size() <= 256
        && (data.type == 'note' || data.type == 'flashcards' || data.type == 'quiz' || data.type == 'mindmap');
    }

    function isValidActivity(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'text'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == userId
        && data.text is string && data.text.size() <= 500;
    }

    function isValidNotification(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'read'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId == userId
        && data.title is string && data.title.size() <= 256
        && data.read is bool;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId) && isValidUser(incoming(), userId);
      allow update: if isValidId(userId) && isOwner(userId) && isValidUser(incoming(), userId);
      allow delete: if isValidId(userId) && isOwner(userId);

      // User Study Items
      match /items/{itemId} {
        allow get: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
        allow list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(itemId) && isOwner(userId) && isValidStudyItem(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(itemId) && isOwner(userId)
          && isValidStudyItem(incoming(), userId)
          && incoming().userId == existing().userId;
        allow delete: if isValidId(userId) && isValidId(itemId) && isOwner(userId);
      }

      // User Learning Activities
      match /activities/{activityId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(activityId) && isOwner(userId) && isValidActivity(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(activityId) && isOwner(userId) && isValidActivity(incoming(), userId);
        allow delete: if isValidId(userId) && isValidId(activityId) && isOwner(userId);
      }

      // User Notifications
      match /notifications/{notificationId} {
        allow get, list: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isValidId(notificationId) && isOwner(userId) && isValidNotification(incoming(), userId);
        allow update: if isValidId(userId) && isValidId(notificationId) && isOwner(userId) && isValidNotification(incoming(), userId);
        allow delete: if isValidId(userId) && isValidId(notificationId) && isOwner(userId);
      }
    }
  }
}
