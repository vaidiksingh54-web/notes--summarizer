{
  "entities": {
    "User": {
      "title": "User",
      "description": "Student user profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "college": { "type": "string" },
        "course": { "type": "string" },
        "avatar": { "type": "string" },
        "bio": { "type": "string" },
        "age": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email", "name"]
    },
    "StudyItem": {
      "title": "StudyItem",
      "description": "Persistent study content including notes, flashcards, quizzes, and mind maps",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["note", "flashcards", "quiz", "mindmap"] },
        "date": { "type": "string" },
        "isFavorite": { "type": "boolean" },
        "content": { "type": "object" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "title", "type"]
    },
    "Activity": {
      "title": "Activity",
      "description": "Student recent activity logs and milestone records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string" },
        "text": { "type": "string" },
        "time": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "text"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Student notifications and reminders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "time": { "type": "string" },
        "read": { "type": "boolean" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "userId", "title", "read"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Private user account profile"
    },
    "/users/{userId}/items/{itemId}": {
      "schema": "StudyItem",
      "description": "User created study items (notes, flashcards, quizzes, mind maps)"
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": "Activity",
      "description": "User learning activity timeline records"
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    }
  }
}
