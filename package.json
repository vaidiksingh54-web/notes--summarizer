{
  "name": "cognistudy-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:api": "tsx watch backend/src/index.ts",
    "dev:web": "vite --port=3000 --host=0.0.0.0",
    "start": "node --import tsx server.ts",
    "build": "vite build && node scripts/copy-assets.mjs",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "tsx --test backend/test/auth.test.ts backend/test/items.test.ts backend/test/ai.test.ts backend/test/profile.test.ts backend/test/database.test.ts backend/test/security.test.ts",
    "db:status": "node scripts/db-status.mjs",
    "db:reset": "node scripts/db-status.mjs --reset"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.117.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "pdfjs-dist": "^3.11.174",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
